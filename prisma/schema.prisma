generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PropertyType {
  RESIDENTIAL
  MIXED_USE
  BOUTIQUE_LOFT
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRING_SOON
  TERMINATED
  EXPIRED
}

enum RenewalStatus {
  PENDING
  RENEWING
  NOT_RENEWING
}

enum ObligationStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  BANK_TRANSFER
  CHECK
  CASH
  MANUAL_ACH
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  STRUCTURAL
  APPLIANCE
  GENERAL
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DocumentCategory {
  LEASE
  TENANT_ID
  MAINTENANCE
  RECEIPT
}

enum NotificationTrigger {
  RENT_UPCOMING
  RENT_OVERDUE
  LEASE_EXPIRING
  MAINTENANCE_CREATED
  MAINTENANCE_STATUS_CHANGED
  UNIT_VACANT_REMINDER
}

enum DeliveryChannel {
  IN_APP
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum RecipientRole {
  MANAGER
  TENANT
}

enum ModelType {
  LOGISTIC_REGRESSION
  RANDOM_FOREST
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
}

model Property {
  id           String       @id @default(cuid())
  name         String
  address      String
  city         String
  state        String
  postalCode   String
  propertyType PropertyType @default(RESIDENTIAL)
  imageUrl     String       @default("/images/courtyard-residence.jpg")
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  buildings    Building[]

  @@index([archivedAt])
}

model Building {
  id                String   @id @default(cuid())
  propertyId        String
  name              String
  code              String
  totalFloors       Int
  hasPhysicalPlan   Boolean  @default(true)
  architectureNotes String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors            Floor[]
  units             Unit[]

  @@unique([propertyId, code])
}

model Floor {
  id          String   @id @default(cuid())
  buildingId  String
  floorNumber Int
  label       String
  createdAt   DateTime @default(now())

  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  units       Unit[]

  @@unique([buildingId, floorNumber])
}

model Unit {
  id          String     @id @default(cuid())
  floorId     String
  buildingId  String
  unitNumber  String
  bedrooms    Int
  bathrooms   Float
  areaSqFt    Int
  targetRent  Float
  status      UnitStatus @default(VACANT)
  gridRow     Int        @default(1)
  gridCol     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  floor               Floor                @relation(fields: [floorId], references: [id], onDelete: Cascade)
  building            Building             @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([buildingId, unitNumber])
  @@index([status])
}

model Tenant {
  id               String   @id @default(cuid())
  fullName         String
  email            String   @unique
  phone            String
  emergencyContact String?
  notes            String?
  demoAccountKey   String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]
  documents           Document[]
}

model Lease {
  id                String        @id @default(cuid())
  unitId            String
  tenantId          String
  startDate         DateTime
  endDate           DateTime
  monthlyRent       Float
  securityDeposit   Float
  paymentDueDay     Int           @default(1)
  status            LeaseStatus   @default(ACTIVE)
  renewalStatus     RenewalStatus @default(PENDING)
  terminatedAt      DateTime?
  terminationReason String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  unit              Unit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  obligations       RentObligation[]
  payments          Payment[]
  documents         Document[]
  predictions       PredictionRecord[]

  @@index([unitId, status])
  @@index([tenantId, status])
  @@index([endDate])
}

model RentObligation {
  id          String           @id @default(cuid())
  leaseId     String
  periodMonth Int
  periodYear  Int
  dueDate     DateTime
  amountDue   Float
  amountPaid  Float            @default(0)
  status      ObligationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lease       Lease              @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments    Payment[]
  predictions PredictionRecord[]

  @@unique([leaseId, periodYear, periodMonth])
  @@index([status, dueDate])
}

model Payment {
  id                  String        @id @default(cuid())
  obligationId        String
  leaseId             String
  amount              Float
  paidAt              DateTime      @default(now())
  method              PaymentMethod @default(BANK_TRANSFER)
  referenceCode       String?
  notes               String?
  isVerifiedBankTx    Boolean       @default(false)
  recordedBy          String        @default("Property Manager")
  createdAt           DateTime      @default(now())

  obligation          RentObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  lease               Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([obligationId])
  @@index([leaseId])
}

model Contractor {
  id         String   @id @default(cuid())
  name       String
  specialty  String
  phone      String
  email      String
  hourlyRate Float
  createdAt  DateTime @default(now())

  requests   MaintenanceRequest[]
}

model MaintenanceRequest {
  id            String              @id @default(cuid())
  unitId        String
  tenantId      String?
  contractorId  String?
  title         String
  description   String
  category      MaintenanceCategory @default(GENERAL)
  priority      MaintenancePriority @default(MEDIUM)
  status        MaintenanceStatus   @default(OPEN)
  estimatedCost Float?
  actualCost    Float?
  notes         String?
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?
  updatedAt     DateTime            @updatedAt

  unit          Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  contractor    Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  documents     Document[]

  @@index([status, priority])
  @@index([unitId])
}

model Document {
  id                   String           @id @default(cuid())
  title                String
  fileName             String
  mimeType             String
  sizeBytes            Int
  storagePath          String
  category             DocumentCategory
  tenantId             String?
  leaseId              String?
  maintenanceRequestId String?
  uploadedAt           DateTime         @default(now())

  tenant               Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  lease                Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([leaseId])
  @@index([maintenanceRequestId])
}

model Notification {
  id                String              @id @default(cuid())
  eventKey          String              @unique
  triggerType       NotificationTrigger
  recipientRole     RecipientRole
  recipientId       String?
  title             String
  message           String
  relatedEntityType String
  relatedEntityId   String
  isRead            Boolean             @default(false)
  deliveryChannel   DeliveryChannel     @default(IN_APP)
  deliveryStatus    DeliveryStatus      @default(SENT)
  createdAt         DateTime            @default(now())
  sentAt            DateTime?

  @@index([recipientRole, isRead])
  @@index([createdAt])
}

model PredictionRecord {
  id              String    @id @default(cuid())
  leaseId         String
  obligationId    String?
  modelName       ModelType
  lateProbability Float
  riskTier        RiskTier
  featureSnapshot Json
  explanation     String
  isSyntheticDemo Boolean   @default(true)
  createdAt       DateTime  @default(now())

  lease           Lease           @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  obligation      RentObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)

  @@index([leaseId])
}
